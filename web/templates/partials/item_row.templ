package partials

import "strconv"

type BookItem struct {
	ID       int
	Title    string
	Author   string
	Category string
	Status   string
	Price    string
}

templ ItemRow(item BookItem) {
	<tr id={ "book-row-" + strconv.Itoa(item.ID) }>
		<td>{ item.Title }</td>
		<td>{ item.Author }</td>
		<td>{ item.Category }</td>
		<td>{ item.Status }</td>
		<td>{ item.Price }</td>
		<td class="actions">
			<a class="button small secondary" href={ "/books/" + strconv.Itoa(item.ID) + "/edit" }>Edit</a>
			<button
				type="button"
				class="button small danger"
				hx-delete={ "/books/" + strconv.Itoa(item.ID) }
				hx-confirm="Are you sure you want to delete this book?"
				hx-target="closest tr"
				hx-swap="outerHTML"
			>
				Delete
			</button>
		</td>
	</tr>
}
